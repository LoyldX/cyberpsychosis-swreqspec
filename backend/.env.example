# Database (CON-DB-01: PostgreSQL assumed from Q4)
DATABASE_URL="postgresql://gym_user:gym_password_dev@localhost:5432/gym_management"

# Redis (CON-CACHE-01: Redis required for session management)
REDIS_URL="redis://localhost:6379"

# JWT Configuration (Q1: Assumption - JWT payload structure)
JWT_ACCESS_SECRET="your-access-token-secret-change-in-production"
JWT_REFRESH_SECRET="your-refresh-token-secret-change-in-production"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Session Configuration (Q2: Assumption - 24 hour TTL, 0.1% acceptable dropout)
SESSION_TTL_HOURS=24
SESSION_ABSOLUTE_TIMEOUT_HOURS=30

# Server Configuration
NODE_ENV="development"
PORT=3000
HOST="0.0.0.0"

# Logging
LOG_LEVEL="debug"

# CORS Configuration
CORS_ORIGIN="http://localhost:3001,http://localhost:8081"

# Firebase Cloud Messaging (FR-NOTI-01 skeleton)
FCM_PROJECT_ID="your-firebase-project-id"
FCM_PRIVATE_KEY="your-firebase-private-key"
FCM_CLIENT_EMAIL="your-firebase-client-email"

# LINE Bot Configuration (FR-LINE-01, FR-LINE-02 skeleton)
LINE_CHANNEL_ID="your-line-channel-id"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_ACCESS_TOKEN="your-line-access-token"

# Door Access System (IF-GATE-01: Webhook for occupancy tracking)
DOOR_SENSOR_WEBHOOK_SECRET="your-door-sensor-webhook-secret"

# Gym Configuration
GYM_CAPACITY=100
GYM_TIMEZONE="Asia/Bangkok"
